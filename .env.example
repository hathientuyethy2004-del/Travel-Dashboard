# MongoDB connection string. Defaults to the local Compose MongoDB service when unset.
MONGODB_URI=mongodb://mongodb:27017
DB_NAME=smart_travel_platform

# Optional: comma-separated RapidAPI keys used by the ETL enrichment jobs.
RAPIDAPI_KEYS=

# Set to true if you want write operations protected by auth middleware.
REQUIRE_AUTH=false

LOG_LEVEL=info
