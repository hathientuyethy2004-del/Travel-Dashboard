FROM node:22-bookworm-slim AS build

WORKDIR /app

ENV CI=true
ENV NODE_ENV=production
ENV PORT=5173
ENV BASE_PATH=/
ENV npm_config_user_agent=pnpm

RUN corepack enable

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml .npmrc tsconfig*.json ./
COPY artifacts/api-server/package.json artifacts/api-server/package.json
COPY artifacts/travel-dashboard/package.json artifacts/travel-dashboard/package.json
COPY artifacts/mockup-sandbox/package.json artifacts/mockup-sandbox/package.json
COPY lib/api-client-react/package.json lib/api-client-react/package.json
COPY lib/api-spec/package.json lib/api-spec/package.json
COPY lib/api-zod/package.json lib/api-zod/package.json
COPY lib/db/package.json lib/db/package.json
COPY scripts/package.json scripts/package.json

RUN pnpm install --frozen-lockfile --ignore-scripts

COPY artifacts/travel-dashboard artifacts/travel-dashboard
COPY lib/api-client-react lib/api-client-react
COPY lib/api-zod lib/api-zod
COPY attached_assets attached_assets

RUN pnpm --filter @workspace/travel-dashboard run build

FROM nginx:1.27-alpine AS runtime

COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/artifacts/travel-dashboard/dist/public /usr/share/nginx/html

EXPOSE 80
